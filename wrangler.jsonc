{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ssl-cert-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // web/dist must exist before wrangler dev / vitest run (npm run build:web first).
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/v1", "/v1/*"]
  },
  // Placeholder IDs are fine for local dev. Replace both before the first remote
  // command or deploy:
  //   npx wrangler d1 create ssl-cert-worker
  //   npx wrangler r2 bucket create ssl-cert-artifacts
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ssl-cert-worker",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CERTS",
      "bucket_name": "ssl-cert-artifacts"
    }
  ],
  "workflows": [
    {
      "name": "certificate-issuance",
      "binding": "ISSUANCE",
      "class_name": "CertificateWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "PULL_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://<team>.cloudflareaccess.com",
    "ACCESS_AUD": "<aud>",
    "ACME_DIRECTORY": "https://acme-staging-v02.api.letsencrypt.org/directory",
    // Local-dev-only bypass for /api/* (see src/auth/access.ts). Empty in every
    // deployed environment; set DEV_ACCESS_EMAIL in .dev.vars for wrangler dev.
    "DEV_ACCESS_EMAIL": ""
  },
  "secrets": {
    "required": ["CF_DNS_API_TOKEN", "ENVELOPE_KEY"]
  },
  "env": {
    // Production: production ACME directory, separate D1/R2. Bindings and vars
    // are non-inheritable and repeated here; `triggers` (cron) and `assets` are
    // inherited from the top level. Deploy with `wrangler deploy --env production`.
    "production": {
      // The two environments share the hostname; moving it is a cutover (the
      // previous Worker must release the route first).
      "routes": [{ "pattern": "ssl.example.com", "custom_domain": true }],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "https://<team>.cloudflareaccess.com",
        "ACCESS_AUD": "<aud>",
        "ACME_DIRECTORY": "https://acme-v02.api.letsencrypt.org/directory",
        "DEV_ACCESS_EMAIL": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ssl-cert-worker-prod",
          "database_id": "00000000-0000-0000-0000-000000000000"
        }
      ],
      "r2_buckets": [
        {
          "binding": "CERTS",
          "bucket_name": "ssl-cert-artifacts-prod"
        }
      ],
      "workflows": [
        {
          "name": "certificate-issuance-production",
          "binding": "ISSUANCE",
          "class_name": "CertificateWorkflow"
        }
      ],
      "ratelimits": [
        {
          "name": "PULL_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "secrets": {
        "required": ["CF_DNS_API_TOKEN", "ENVELOPE_KEY"]
      }
    }
  }
}
