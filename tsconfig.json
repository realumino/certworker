{
  "compilerOptions": {
    /* Language and environment */
    "target": "es2024",
    "lib": ["es2024"],

    /* Modules */
    "module": "es2022",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,

    /* Emit */
    "noEmit": true,

    /* Interop / correctness */
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    /* Type checking */
    "strict": true,
    "skipLibCheck": true,

    /* Runtime + bindings types generated by `npm run types` (wrangler types).
       Explicit list prevents @types packages hoisted by the web workspace from
       leaking into the Worker program. */
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test"]
}
