#!/usr/bin/env bash
#
# certworker-agent — reference node agent for certworker.
#
# Usage: certworker-agent <domain> [domain ...]
#
# Pulls the current certificate for each domain from the node pull API and
# installs it to an app-owned location (no web-server coupling):
#
#   $CERTWORKER_CERT_DIR/<domain>.pem          fullchain (leaf + intermediate chain)
#   $CERTWORKER_KEY_DIR/<domain>.key           private key, mode 600
#   $CERTWORKER_CERT_DIR/wildcard.<domain>.pem for a `*.example.com` row
#   $CERTWORKER_KEY_DIR/wildcard.<domain>.key
#
# The certificate ETag is stored so repeat runs are no-ops (HTTP 304). New
# material is staged as `<file>.new`, checked with openssl (parses, and the key
# matches the certificate) and only then moved into place. If
# CERTWORKER_RELOAD_CMD is set it runs once, after all domains have been
# processed. Any failure exits non-zero.
#
# Environment overrides (defaults in parentheses) exist for non-default layouts
# and for the offline test harness:
#   CERTWORKER_API         base URL of the pull API       (https://certworker.example.org/v1)
#   CERTWORKER_CONF_DIR    holds `token` (0600)           (/etc/certworker)
#   CERTWORKER_STATE_DIR   holds etags and staging files  (/var/lib/certworker)
#   CERTWORKER_CERT_DIR    destination for fullchain .pem (/etc/certworker/certs)
#   CERTWORKER_KEY_DIR     destination for private .key   (/etc/certworker/private)
#   CERTWORKER_RELOAD_CMD  optional command run after a change (unset)
#
# If `access-client-id` and `access-client-secret` exist in CERTWORKER_CONF_DIR,
# every request additionally carries the CF-Access-Client-Id / -Secret headers
# for a Cloudflare Access Service Auth policy.
set -euo pipefail

API_BASE="${CERTWORKER_API:-https://certworker.example.org/v1}"
CONF_DIR="${CERTWORKER_CONF_DIR:-/etc/certworker}"
TOKEN_FILE="$CONF_DIR/token"
ACCESS_ID_FILE="$CONF_DIR/access-client-id"
ACCESS_SECRET_FILE="$CONF_DIR/access-client-secret"
STATE_DIR="${CERTWORKER_STATE_DIR:-/var/lib/certworker}"
CERT_DIR="${CERTWORKER_CERT_DIR:-/etc/certworker/certs}"
KEY_DIR="${CERTWORKER_KEY_DIR:-/etc/certworker/private}"
RELOAD_CMD="${CERTWORKER_RELOAD_CMD:-}"

log() { printf 'certworker-agent: %s\n' "$*"; }
err() { printf 'certworker-agent: %s\n' "$*" >&2; }

# Pull failures are logged with the content type so an HTML body from an
# intercepting proxy (Cloudflare Access) is obvious.
report_http_error() {
  local domain="$1" code="$2" headers="$3" content_type=""
  content_type="$(awk 'tolower($1) == "content-type:" { sub(/\r$/, "", $2); ct = $2 } END { print ct }' "$headers" 2>/dev/null || true)"
  err "$domain pull failed: HTTP ${code:-???}${content_type:+ (content-type: $content_type)}"
  if [[ "$content_type" == text/html* ]]; then
    err "$domain returned HTML; Cloudflare Access is blocking /v1 (app B must be Bypass or Service Auth, not Allow)"
  elif [[ "$code" == "401" || "$code" == "403" ]]; then
    err "$domain was rejected; check the API key in $TOKEN_FILE and, with Access Service Auth, $ACCESS_ID_FILE / $ACCESS_SECRET_FILE"
  elif [[ "$code" == "429" ]]; then
    err "$domain is rate limited; the next timer run will retry"
  fi
}

header_value() {
  awk -v name="$2" 'tolower($1) == name { $1=""; sub(/^ /,""); sub(/\r$/,""); last=$0 } END { print last }' "$1"
}

[[ $# -ge 1 ]] || { err "usage: certworker-agent <domain> [domain ...]"; exit 2; }

for cmd in curl openssl; do
  command -v "$cmd" >/dev/null || { err "$cmd is required but not installed"; exit 1; }
done

[[ -r "$TOKEN_FILE" ]] || { err "missing or unreadable token file: $TOKEN_FILE"; exit 1; }
TOKEN="$(cat "$TOKEN_FILE")"
[[ -n "$TOKEN" ]] || { err "token file is empty: $TOKEN_FILE"; exit 1; }

auth_args=(-H "Authorization: Bearer $TOKEN")
if [[ -e "$ACCESS_ID_FILE" || -e "$ACCESS_SECRET_FILE" ]]; then
  [[ -r "$ACCESS_ID_FILE" && -r "$ACCESS_SECRET_FILE" ]] \
    || { err "Access service token needs both $ACCESS_ID_FILE and $ACCESS_SECRET_FILE"; exit 1; }
  access_id="$(cat "$ACCESS_ID_FILE")"
  access_secret="$(cat "$ACCESS_SECRET_FILE")"
  [[ -n "$access_id" && -n "$access_secret" ]] \
    || { err "Access service token files must not be empty: $ACCESS_ID_FILE / $ACCESS_SECRET_FILE"; exit 1; }
  auth_args+=(-H "CF-Access-Client-Id: $access_id" -H "CF-Access-Client-Secret: $access_secret")
fi

umask 077
mkdir -p "$STATE_DIR" "$CERT_DIR" "$KEY_DIR"

changed=0
failed=0

for domain in "$@"; do
  # Wildcard rows map to `wildcard.<name>` on disk, matching the admin download
  # filenames; the API path keeps the literal `*.example.com`.
  safe_name="${domain/#\*./wildcard.}"
  etag_file="$STATE_DIR/$safe_name.etag"
  tmp_cert_headers="$STATE_DIR/$safe_name.cert-headers.new"
  tmp_key_headers="$STATE_DIR/$safe_name.key-headers.new"
  tmp_cert="$CERT_DIR/$safe_name.pem.new"
  tmp_key="$KEY_DIR/$safe_name.key.new"

  # One conditional request per domain: 304 means nothing changed.
  cert_args=(-sS --proto '=https' --connect-timeout 10 --max-time 120
             -D "$tmp_cert_headers" -o "$tmp_cert" -w '%{http_code}'
             "${auth_args[@]}")
  if [[ -f "$etag_file" ]]; then
    cert_args+=(-H "If-None-Match: $(cat "$etag_file")")
  fi

  code="$(curl "${cert_args[@]}" "$API_BASE/domains/$domain/files/fullchain" || true)"

  if [[ "$code" == "304" ]]; then
    log "$domain unchanged"
    rm -f "$tmp_cert" "$tmp_cert_headers"
    continue
  fi

  if [[ "$code" != "200" ]]; then
    report_http_error "$domain" "$code" "$tmp_cert_headers"
    rm -f "$tmp_cert" "$tmp_cert_headers"
    failed=1
    continue
  fi

  new_etag="$(header_value "$tmp_cert_headers" etag:)"
  if [[ -z "$new_etag" ]]; then
    err "$domain response is missing an ETag"
    rm -f "$tmp_cert" "$tmp_cert_headers"
    failed=1
    continue
  fi

  key_code="$(curl -sS --proto '=https' --connect-timeout 10 --max-time 120 \
    -D "$tmp_key_headers" -o "$tmp_key" -w '%{http_code}' \
    "${auth_args[@]}" "$API_BASE/domains/$domain/files/key" || true)"
  if [[ "$key_code" != "200" ]]; then
    report_http_error "$domain (key)" "$key_code" "$tmp_key_headers"
    rm -f "$tmp_cert" "$tmp_key" "$tmp_cert_headers" "$tmp_key_headers"
    failed=1
    continue
  fi
  chmod 600 "$tmp_key"

  invalid=0
  openssl x509 -noout -in "$tmp_cert" 2>/dev/null \
    || { err "$domain fullchain is not a valid certificate"; invalid=1; }
  openssl pkey -noout -in "$tmp_key" 2>/dev/null \
    || { err "$domain private key is not valid"; invalid=1; }
  if [[ $invalid -eq 0 ]] \
    && [[ "$(openssl x509 -noout -pubkey -in "$tmp_cert")" != "$(openssl pkey -pubout -in "$tmp_key")" ]]; then
    err "$domain certificate and private key do not match"
    invalid=1
  fi
  if [[ $invalid -ne 0 ]]; then
    rm -f "$tmp_cert" "$tmp_key" "$tmp_cert_headers" "$tmp_key_headers"
    failed=1
    continue
  fi

  mv -f "$tmp_cert" "$CERT_DIR/$safe_name.pem"
  mv -f "$tmp_key" "$KEY_DIR/$safe_name.key"
  printf '%s\n' "$new_etag" > "$etag_file"
  serial="$(openssl x509 -noout -serial -in "$CERT_DIR/$safe_name.pem" 2>/dev/null | cut -d= -f2 || true)"
  log "$domain updated (serial ${serial:-unknown})"
  changed=1
  rm -f "$tmp_cert_headers" "$tmp_key_headers"
done

if [[ $changed -eq 1 && -n "$RELOAD_CMD" ]]; then
  if sh -c "$RELOAD_CMD"; then
    log "reload command succeeded"
  else
    err "reload command failed after a certificate update"
    failed=1
  fi
fi

exit $failed
